classDiagram
  direction LR

  %% Visibility: + public, - private, ~ internal; classifier: $ static
  %% Constructor parameters are validated initial state, not injected services.
  %% Contract reference: PRD v1.3, sections 7.0-7.4, and TASKS W1-12.
  %% Contract targets guide unfinished W1-12 code; planned types are not implemented yet.
  %% Public data properties have no public setters; child collections expose read-only views.

  %% Aggregate roots
  class Employee {
    <<aggregate root>>
    +EmployeeId Id
    +string FullName
    +Email Email
    +DateOnly HireDate
    +EmployeeId? ManagerId
    +PositionId? PositionId
    +DateTimeOffset? AdminGrantedAt
    +SystemRole Role
    +bool IsActive
    -Employee(id: EmployeeId, fullName: string, email: Email, hireDate: DateOnly, managerId: EmployeeId?, positionId: PositionId?)
    +Create(fullName: string?, email: Email?, hireDate: DateOnly, managerId: EmployeeId?, positionId: PositionId?) Result~Employee~$
    +AssignManager(managerId: EmployeeId?) Result
    +AssignPosition(positionId: PositionId?) Result
    +GrantAdmin(actorId: EmployeeId, grantedAt: DateTimeOffset) Result
    +RevokeAdmin(actorId: EmployeeId) Result
    +Deactivate() Result
    +Activate() Result
    ~ApplyResolvedRole(role: SystemRole) void
  }

  class LeaveBalance {
    <<aggregate root>>
    +LeaveBalanceId Id
    +EmployeeId EmployeeId
    +int Year
    +LeaveDays AnnualQuota
    +LeaveDays CarriedOver
    +DateOnly CarryOverExpiresAt
    +LeaveDays AnnualUsed
    +LeaveDays AnnualReserved
    +LeaveDays CarryOverUsed
    +LeaveDays CarryOverReserved
    +IReadOnlyList~QuotaAdjustment~ Adjustments
    -List~QuotaAdjustment~ _adjustments
    -LeaveBalance(id: LeaveBalanceId, employeeId: EmployeeId, year: int, annualQuota: LeaveDays, carriedOver: LeaveDays, carryOverExpiresAt: DateOnly)
    +Create(employeeId: EmployeeId, year: int, annualQuota: LeaveDays, carriedOver: LeaveDays) Result~LeaveBalance~$
    +CalculateProratedQuota(hireDate: DateOnly, year: int) Result~LeaveDays~$
    +CalculateCarryOver(remaining: LeaveDays) LeaveDays$
    +Available(asOf: DateOnly) LeaveDays
    +Reserve(days: LeaveDays, asOf: DateOnly) Result~LeaveAllocation~
    +ReleaseReservation(allocation: LeaveAllocation, asOf: DateOnly) Result
    +ConfirmUsage(allocation: LeaveAllocation) Result
    +CancelUsage(allocation: LeaveAllocation, asOf: DateOnly) Result
    +Adjust(days: int, reason: Reason?, actorId: EmployeeId, now: DateTimeOffset) Result
    +ExpireCarryOver(asOf: DateOnly) Result
  }

  class LeaveRequest {
    <<aggregate root>>
    <<contract target>>
    +LeaveRequestId Id
    +EmployeeId EmployeeId
    +DateRange Period
    +LeaveDays WorkingDays
    +LeaveAllocation Allocation
    +LeaveType Type
    +Reason Reason
    +LeaveStatus Status
    +IReadOnlyList~ApprovalDecision~ Decisions
    -List~ApprovalDecision~ _decisions
    +DateTimeOffset SubmittedAt
    -LeaveRequest(id: LeaveRequestId, employeeId: EmployeeId, period: DateRange, workingDays: LeaveDays, allocation: LeaveAllocation, type: LeaveType, reason: Reason, submittedAt: DateTimeOffset)
    +Create(employeeId: EmployeeId, period: DateRange, workingDays: LeaveDays, allocation: LeaveAllocation, type: LeaveType, reason: Reason, today: DateOnly, submittedAt: DateTimeOffset) Result~LeaveRequest~$
    +ApproveFirstStage(approverId: EmployeeId, requiresFinalApproval: bool, reason: Reason?, now: DateTimeOffset) Result
    +ApproveFinalStage(approverId: EmployeeId, reason: Reason?, now: DateTimeOffset) Result
    +Override(actorId: EmployeeId, bypassedApproverId: EmployeeId?, outcome: DecisionType, reason: Reason?, now: DateTimeOffset) Result
    +Reject(actorId: EmployeeId, reason: Reason?, now: DateTimeOffset) Result
    +Cancel(actorId: EmployeeId, today: DateOnly, reason: Reason?, now: DateTimeOffset) Result
  }

  %% today validates the request year in Create; it is not stored or passed to the constructor.
  %% Status starts Pending and Decisions starts empty; neither is caller-supplied initial state.
  %% requiresFinalApproval is supplied by Application; PendingFinalApproval preserves the route.

  %% Reference aggregates
  class Position {
    <<reference aggregate>>
    <<planned>>
    +PositionId Id
    +string Name
    +bool IsActive
    -Position(id: PositionId, name: string)
    +Create(name: string) Result~Position~$
    +Rename(name: string) Result
    +Deactivate() Result
  }

  class Holiday {
    <<reference aggregate>>
    <<planned>>
    +Guid Id
    +DateOnly Date
    +string Name
    +HolidaySource Source
    -Holiday(id: Guid, date: DateOnly, name: string, source: HolidaySource)
    +Create(date: DateOnly, name: string, source: HolidaySource) Result~Holiday~$
    +Rename(name: string) Result
  }

  %% Child entities

  class ApprovalDecision {
    <<entity>>
    <<contract target>>
    +Guid Id
    +LeaveRequestId LeaveRequestId
    +EmployeeId ActorId
    +DecisionType Type
    +ApprovalStage Stage
    +Reason? Reason
    +EmployeeId? BypassedApproverId
    +DecisionType? OverrideOutcome
    +DateTimeOffset DecidedAt
    -ApprovalDecision(id: Guid, requestId: LeaveRequestId, actorId: EmployeeId, type: DecisionType, stage: ApprovalStage, reason: Reason?, bypassedApproverId: EmployeeId?, overrideOutcome: DecisionType?, decidedAt: DateTimeOffset)
    +Create(requestId: LeaveRequestId, actorId: EmployeeId, type: DecisionType, stage: ApprovalStage, reason: Reason?, bypassedApproverId: EmployeeId?, overrideOutcome: DecisionType?, decidedAt: DateTimeOffset) Result~ApprovalDecision~$
  }

  class QuotaAdjustment {
    <<entity>>
    +Guid Id
    +LeaveBalanceId LeaveBalanceId
    +int Days
    +Reason Reason
    +EmployeeId AdjustedBy
    +DateTimeOffset AdjustedAt
    -QuotaAdjustment(id: Guid, leaveBalanceId: LeaveBalanceId, days: int, reason: Reason, adjustedBy: EmployeeId, adjustedAt: DateTimeOffset)
    +Create(leaveBalanceId: LeaveBalanceId, days: int, reason: Reason?, adjustedBy: EmployeeId, adjustedAt: DateTimeOffset) Result~QuotaAdjustment~$
  }

  %% Operational records
  class AuditEntry {
    <<operational record>>
    <<planned>>
    +Guid Id
    +string EntityType
    +string EntityId
    +string Action
    +EmployeeId? ActorId
    +string? ActorSnapshot
    +string Payload
    +DateTimeOffset OccurredAt
    -AuditEntry(id: Guid, entityType: string, entityId: string, action: string, actorId: EmployeeId?, actorSnapshot: string?, payload: string, occurredAt: DateTimeOffset)
    +Create(entityType: string, entityId: string, action: string, actorId: EmployeeId?, actorSnapshot: string?, payload: string, occurredAt: DateTimeOffset) Result~AuditEntry~$
  }

  class JobExecutionMarker {
    <<operational record>>
    <<planned>>
    +Guid Id
    +string JobName
    +string PeriodKey
    +DateTimeOffset ExecutedAt
    -JobExecutionMarker(id: Guid, jobName: string, periodKey: string, executedAt: DateTimeOffset)
    +Create(jobName: string, periodKey: string, executedAt: DateTimeOffset) Result~JobExecutionMarker~$
  }

  %% Value objects
  class EmployeeId {
    <<value object>>
    +Guid Value
    -EmployeeId(value: Guid)
    +New() EmployeeId$
    +Create(value: Guid) Result~EmployeeId~$
    +ToString() string
  }

  class LeaveRequestId {
    <<value object>>
    +Guid Value
    -LeaveRequestId(value: Guid)
    +New() LeaveRequestId$
    +Create(value: Guid) Result~LeaveRequestId~$
    +ToString() string
  }

  class LeaveBalanceId {
    <<value object>>
    +Guid Value
    -LeaveBalanceId(value: Guid)
    +New() LeaveBalanceId$
    +Create(value: Guid) Result~LeaveBalanceId~$
    +ToString() string
  }

  class PositionId {
    <<value object>>
    +Guid Value
    -PositionId(value: Guid)
    +New() PositionId$
    +Create(value: Guid) Result~PositionId~$
    +ToString() string
  }

  class Email {
    <<value object>>
    +string Value
    -Email(value: string)
    +Create(value: string?) Result~Email~$
  }

  class Reason {
    <<value object>>
    +string Value
    -Reason(value: string)
    +Create(value: string?) Result~Reason~$
  }

  class LeaveDays {
    <<value object>>
    +int Value
    +LeaveDays Zero$
    -LeaveDays(value: int)
    +Create(value: int) Result~LeaveDays~$
    +Add(other: LeaveDays) LeaveDays
    +Subtract(other: LeaveDays) Result~LeaveDays~
  }

  class DateRange {
    <<value object>>
    +DateOnly Start
    +DateOnly End
    -DateRange(start: DateOnly, end: DateOnly)
    +Create(start: DateOnly, end: DateOnly) Result~DateRange~$
    +OverlapsWith(other: DateRange) bool
    +DurationInDays() int
  }

  class LeaveAllocation {
    <<value object>>
    +LeaveDays Annual
    +LeaveDays CarryOver
    +LeaveDays Total
    -LeaveAllocation(annual: LeaveDays, carryOver: LeaveDays)
    +Create(annual: LeaveDays, carryOver: LeaveDays) Result~LeaveAllocation~$
  }

  %% Domain services
  class LeaveCalculator {
    <<domain service>>
    +Calculate(period: DateRange, holidays: IReadOnlyCollection~DateOnly~) LeaveDays
  }

  class RoleResolver {
    <<domain service>>
    +Resolve(employee: Employee, activeSubordinateCount: int) SystemRole
  }

  %% Enumerations
  class SystemRole {
    <<enumeration>>
    Employee = 0
    SuperEmployee = 1
    Administrator = 2
  }

  class LeaveStatus {
    <<enumeration>>
    Pending
    PendingFinalApproval
    Approved
    Rejected
    Cancelled
  }

  class LeaveType {
    <<enumeration>>
    AnnualLeave
    SickLeave
  }

  class DecisionType {
    <<enumeration>>
    Approve
    Reject
    Override
    Cancel
  }

  class ApprovalStage {
    <<enumeration>>
    First
    Final
  }

  class HolidaySource {
    <<enumeration>>
    <<planned>>
    Manual
    Imported
  }

  %% Aggregate composition and domain associations
  Employee "0..1" --> "0..*" Employee : manages
  Position "0..1" <-- "0..*" Employee : assigned position
  Employee "1" <-- "0..*" LeaveBalance : owner
  Employee "1" <-- "0..*" LeaveRequest : requester
  LeaveBalance "1" *-- "0..*" QuotaAdjustment : adjustments
  LeaveRequest "1" *-- "0..*" ApprovalDecision : decisions

  %% Value-object ownership
  Employee *-- EmployeeId : identity
  Employee *-- Email
  Employee --> PositionId : position reference
  Position *-- PositionId : identity
  LeaveBalance *-- LeaveBalanceId : identity
  LeaveBalance *-- LeaveDays : quantities
  LeaveBalance ..> LeaveAllocation : allocates and settles
  LeaveAllocation *-- LeaveDays : portions
  LeaveRequest *-- LeaveRequestId : identity
  LeaveRequest *-- DateRange : period
  LeaveRequest *-- LeaveDays : working days
  LeaveRequest *-- LeaveAllocation : frozen allocation
  LeaveRequest *-- Reason

  %% Service dependencies
  LeaveCalculator ..> DateRange
  LeaveCalculator ..> LeaveDays
  RoleResolver ..> Employee
  RoleResolver ..> SystemRole

  %% Enumeration dependencies
  Employee ..> SystemRole : uses
  LeaveRequest ..> LeaveStatus : uses
  LeaveRequest ..> LeaveType : uses
  LeaveRequest ..> DecisionType : override outcome
  ApprovalDecision ..> DecisionType : uses
  ApprovalDecision ..> ApprovalStage : uses
  Holiday ..> HolidaySource : uses
